// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`SqlExporter.insert > renders one multi-row INSERT per batch with quoted identifiers and escaped literals 1`] = `
"INSERT INTO \`we\`\`ird\` (\`id\`, \`s\`, \`n\`, \`b\`, \`f\`) VALUES
(1, 'it''s', NULL, X'0102', 1),
(2, 'plain', 3.5, NULL, 0);"
`;

exports[`SqlExporter.insert > renders one multi-row INSERT per batch with quoted identifiers and escaped literals 2`] = `
"INSERT INTO "app"."we""ird" ("id", "s", "n", "b", "f") VALUES
(1, 'it''s', NULL, '\\x0102'::bytea, TRUE),
(2, 'plain', 3.5, NULL, FALSE);"
`;

exports[`program objects > strips only the header DEFINER, wraps MySQL programs in their sql_mode and keeps bodies verbatim 1`] = `
"SET @tsmyadmin_sql_mode = @@sql_mode;
SET @tsmyadmin_time_zone = @@time_zone;
DELIMITER $$
SET sql_mode = 'STRICT_TRANS_TABLES'$$
DROP PROCEDURE IF EXISTS \`p\`$$
CREATE PROCEDURE \`p\`()
BEGIN SELECT 'DEFINER=root@localhost' AS s; END$$

SET sql_mode = ''$$
SET time_zone = '+09:00'$$
DROP EVENT IF EXISTS \`ev\`$$
CREATE EVENT \`ev\` ON SCHEDULE AT '2030-01-01 00:00:00' ON COMPLETION PRESERVE ENABLE COMMENT 'it''s'
DO DELETE FROM t$$

DELIMITER ;
SET sql_mode = @tsmyadmin_sql_mode;
SET time_zone = @tsmyadmin_time_zone;

"
`;
