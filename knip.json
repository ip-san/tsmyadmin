{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreUnresolved": [
    "./src/test/setup.ts"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "e2e/**/*.ts",
        "lighthouserc.cjs",
        "scripts/*.mjs"
      ],
      "project": [
        "scripts/**/*.mjs",
        "e2e/**/*.ts"
      ],
      "ignoreDependencies": [
        "type-coverage"
      ]
    },
    "packages/shared": {
      "entry": [
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/adapter": {
      "entry": [
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "apps/api": {
      "entry": [
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "apps/web": {
      "entry": [
        "src/routes/**/*.tsx",
        "src/**/*.test.{ts,tsx}"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "tailwindcss",
        "jsdom"
      ]
    }
  }
}
