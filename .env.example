# See docs/deployment.md for the full description of every variable.
NODE_ENV=development
API_PORT=3100
# Required in production (>= 32 chars): openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_MINUTES=30
# Live sessions per database account; the least recently used is closed beyond this
SESSION_MAX_PER_IDENTITY=10
# memory (development default) | sqlite (production default; survives restarts, credentials encrypted)
SESSION_STORE=
SESSION_DB_PATH=data/sessions.sqlite
# Database hosts the login form may connect to: exact hosts, *.suffix, or * (anything), each optionally with :port.
# Entries without a port allow every port on that host — always list host:port in production.
TSMYADMIN_ALLOWED_HOSTS=127.0.0.1,localhost
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
# 1 when a reverse proxy sets X-Forwarded-For (the last element is trusted)
TRUST_PROXY=0
# json (production default) | pretty (development default)
LOG_FORMAT=
# Connection presets for the login screen (JSON array, no passwords). Preset hosts are allowed automatically.
# TSMYADMIN_SERVERS=[{"name":"prod","dialect":"postgres","host":"db.internal","port":5432,"database":"app"}]
TSMYADMIN_SERVERS=
# Built SPA directory served by the API (default: apps/web/dist)
WEB_DIST=
# Seconds to wait for in-flight requests on SIGTERM before exiting
SHUTDOWN_TIMEOUT_SECONDS=30
# Web (Vite dev server)
WEB_PORT=5175
# Test databases (docker compose)
TEST_MYSQL_URL=mysql://tsmyadmin:tsmyadmin@127.0.0.1:13306/tsmyadmin_test
TEST_PG_URL=postgres://tsmyadmin:tsmyadmin@127.0.0.1:15433/tsmyadmin_test
