# See docs/deployment.md for the full description of every variable.
NODE_ENV=development
API_PORT=3100
# COOKIE_SECURE=0 only on a TLS-free internal network (production default: 1; a plain-HTTP login is refused otherwise)
COOKIE_SECURE=
# Required in production (>= 32 chars): openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_MINUTES=30
# Live sessions per database account; the least recently used is closed beyond this
SESSION_MAX_PER_IDENTITY=10
# memory (development default) | sqlite (production default; survives restarts, credentials encrypted)
SESSION_STORE=
SESSION_DB_PATH=data/sessions.sqlite
# SESSION_STORE=redis のときだけ必須
REDIS_URL=
# Database hosts the login form may connect to: exact hosts, *.suffix, or * (anything), each optionally with :port.
# Entries without a port allow every port on that host — always list host:port in production.
TSMYADMIN_ALLOWED_HOSTS=127.0.0.1,localhost
# 1 requires every account to enrol a second factor (TOTP); needs SESSION_STORE=sqlite or redis
TSMYADMIN_REQUIRE_2FA=0
# Origin passkeys are bound to (e.g. https://db.example.com); empty = passkeys not offered. See docs/deployment.md
TSMYADMIN_PASSKEY_ORIGIN=
# Hosts the "image link" display transformation may load pictures from (comma-separated host or *.suffix, optional :port); empty = none. See docs/deployment.md
TSMYADMIN_IMAGE_HOSTS=
# 1 lists the database containers of the local Docker daemon on the login screen (development only; refused in production). See docs/deployment.md
TSMYADMIN_DOCKER_DISCOVERY=0
# 1 (with TSMYADMIN_DOCKER_DISCOVERY=1) signs in to a discovered container with the login from its environment, in one click (development only). See docs/deployment.md
TSMYADMIN_DOCKER_LOGIN=0
TSMYADMIN_DOCKER_SOCKET=/var/run/docker.sock
# Default: 127.0.0.1 on the host, host.docker.internal in a container
TSMYADMIN_DOCKER_CONNECT_HOST=
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
# 1 when a reverse proxy sets X-Forwarded-For (the last element is trusted) and X-Forwarded-Proto (for the Secure-cookie login check)
# 0 / 1 / cloudflare
TRUST_PROXY=0
# json (production default) | pretty (development default)
LOG_FORMAT=
# Connection presets for the login screen (JSON array, no passwords). Preset hosts are allowed automatically.
# TSMYADMIN_SERVERS=[{"name":"prod","dialect":"postgres","host":"db.internal","port":5432,"database":"app"}]
TSMYADMIN_SERVERS=
# Built SPA directory served by the API (default: apps/web/dist)
WEB_DIST=
# Seconds to wait for in-flight requests on SIGTERM before exiting
SHUTDOWN_TIMEOUT_SECONDS=30
# Web (Vite dev server)
WEB_PORT=5175
# Test databases (docker compose)
TEST_MYSQL_URL=mysql://tsmyadmin:tsmyadmin@127.0.0.1:13306/tsmyadmin_test
TEST_PG_URL=postgres://tsmyadmin:tsmyadmin@127.0.0.1:15433/tsmyadmin_test
